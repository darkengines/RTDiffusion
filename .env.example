# Copy to .env.local and keep your machine-specific paths there.
# .env.local is ignored by git.

RTD_DEVICE=cuda
# Leave unset to expose all GPUs to RTDiffusion's per-task GPU selector.
# CUDA_VISIBLE_DEVICES=0
RTD_LOG_LEVEL=INFO

# Local development server binding. start.ps1/start.bat/start.sh read these.
# RTD_BACKEND_HOST=127.0.0.1
# RTD_BACKEND_PORT=8000
# RTD_FRONTEND_HOST=127.0.0.1
# RTD_FRONTEND_PORT=5173

# Frontend API target. start scripts default these from RTD_BACKEND_*.
# Set explicitly if the browser must reach the backend through a different host.
# VITE_BACKEND_HOST=127.0.0.1
# VITE_BACKEND_PORT=8000
# VITE_BACKEND_PROTOCOL=http

# Override CORS origins when serving the frontend from another host.
# RTD_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|0\.0\.0\.0):\d+

# Use a local checkpoint or a Diffusers model id.
# RTD_MODEL_PATH=C:\path\to\model.safetensors
# RTD_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1

# Let the UI model picker scan local model and LoRA folders.
# On Windows, separate multiple folders with ;
# RTD_MODEL_DIRS=C:\ComfyUI\models\checkpoints;C:\ComfyUI\models\diffusers
# RTD_LORA_DIRS=C:\ComfyUI\models\loras
# RTD_VIDEO_MODEL_DIRS=C:\ComfyUI\models\diffusion_models;C:\ComfyUI\models\diffusers

# If RTD_MODEL_DIRS / RTD_LORA_DIRS are omitted, RTDiffusion scans local ignored folders:
# models, checkpoints, diffusers, loras, and models/loras.

# Optional Z-Image local base assets.
# RTD_Z_IMAGE_BASE_MODEL=Tongyi-MAI/Z-Image-Turbo
# RTD_Z_IMAGE_LOCAL_ONLY=0

# Realtime acceleration tuning. Enabled by default when Residual CFG or SSF is checked.
# RTD_REALTIME_ACCEL=1
# RTD_SSF_IMAGE_THRESHOLD=9.0
# RTD_SSF_MASK_THRESHOLD=6.0
# RTD_SSF_SKIP_PROBABILITY=0.96
# RTD_SSF_MAX_SKIPS=12
# Enable the experimental direct StreamDiffusion LCMScheduler/U-Net path.
# RTD_STREAM_DIRECT=0
# Compile the direct StreamDiffusion U-Net batch with TorchInductor/Triton when CUDA Triton is available.
# RTD_STREAM_COMPILE=1
# Auto-inject LCM LoRA (latent-consistency/lcm-lora-sdxl or sdv1-5) on first StreamDiffusion session
# for non-Turbo/LCM models. This enables any SDXL model to run at 1-4 steps with good quality.
# Disable if you want to manage fast-inference LoRAs yourself or avoid the HuggingFace download.
# RTD_STREAM_LCM_LORA=1
# Export the StreamDiffusion UNet to TensorRT for maximum throughput (requires setup.ps1 -TRT).
# First frame of a new session triggers ONNX export + TRT engine build (~5-10 min); cached after.
# RTD_STREAM_TRT=0
# RTD_STREAM_TRT_FP16=1
# RTD_STREAM_TRT_CACHE=outputs/trt-engines
# RCFG delta: scale applied to stock_noise when cfg_type=self. 1.0 works well for Turbo/LCM models.
# RTD_STREAM_RCFG_DELTA=1.0

# Native true motion loop generation. RTDiffusion uses Diffusers directly; the
# ComfyUI directories are only model search locations, not a ComfyUI runtime.
# LTX can load supported single-file checkpoints. WAN can load a full Diffusers
# Image-to-Video model directory/model id, or assemble a WAN 2.2 high/low native
# offline clip pipeline from local ComfyUI component files.
# RTD_MOTION_BACKEND=native
# RTD_NATIVE_LTX_MODEL=D:\comfyui\comfy\models\checkpoints\ltx-2.3-22b-dev-fp8.safetensors
# RTD_NATIVE_LTX2_MODEL=D:\comfyui\comfy\models\checkpoints\ltx-2.3-22b-dev-fp8.safetensors
# RTD_NATIVE_WAN_MODEL=D:\models\wan-i2v-diffusers
# RTD_NATIVE_WAN_HIGH_MODEL=D:\comfyui\comfy\models\diffusion_models\wan22RemixT2VI2V_i2vHighV21.safetensors
# RTD_NATIVE_WAN_LOW_MODEL=D:\comfyui\comfy\models\diffusion_models\wan22RemixT2VI2V_i2vLowV21.safetensors
# RTD_NATIVE_WAN_TEXT_ENCODER=D:\comfyui\comfy\models\text_encoders\umt5_xxl_fp8_e4m3fn_scaled.safetensors
# RTD_NATIVE_WAN_VAE=D:\comfyui\comfy\models\vae\wan_2.1_vae.safetensors
# RTD_NATIVE_WAN_CONFIG_REPO=Wan-AI/Wan2.2-I2V-A14B-Diffusers
# RTD_NATIVE_VIDEO_MAX_SIDE=768
# RTD_NATIVE_VIDEO_MAX_FRAMES=33
# RTD_NATIVE_VIDEO_STEPS=8
# RTD_NATIVE_VIDEO_CFG=4.5
# RTD_NATIVE_VIDEO_CPU_OFFLOAD=1
# RTD_NATIVE_WAN_CPU_OFFLOAD=1
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# RTD_NATIVE_VIDEO_CONFIG_CACHE=outputs/hf-configs
# RTD_NATIVE_VIDEO_HF_CACHE=outputs/hf-cache
# RTD_NATIVE_VIDEO_CONFIG_DIR=
# RTD_NATIVE_WAN_COMPILE=1
# Stream WAN latent previews every N denoise steps. Disabled by default because it adds callback tensor traffic.
# RTD_NATIVE_WAN_LATENT_PREVIEW_INTERVAL=0

# Causal-Forcing I2V adapter. This is a real autoregressive video backend, but
# it runs from the upstream repository/environment because it is not a Diffusers
# pipeline. Use a frame-wise config for I2V.
# RTD_CAUSAL_FORCING_REPO=D:\models\Causal-Forcing
# RTD_CAUSAL_FORCING_PYTHON=D:\models\Causal-Forcing\.venv\Scripts\python.exe
# RTD_CAUSAL_FORCING_CONFIG=D:\models\Causal-Forcing\configs\causal_forcing_dmd_framewise.yaml
# RTD_CAUSAL_FORCING_CHECKPOINT=D:\models\Causal-Forcing\checkpoints\framewise\causal_forcing.pt
# Causal-Forcing frame-wise I2V uses a fixed 21-latent cache window upstream.
# Smaller chunks reduce latency for the continuous autoregressive loop.
# RTD_CAUSAL_FORCING_MAX_FRAMES=9
# RTD_CAUSAL_FORCING_LATENT_WINDOW=21
# RTD_CAUSAL_FORCING_INPUT_SIZE=832x480
# RTD_CAUSAL_FORCING_ROTATE_PORTRAIT=0
# RTD_CAUSAL_FORCING_FIT=crop
# RTD_MOTION_OUTPUT_FIT=crop
# RTD_CAUSAL_FORCING_TIMEOUT=1800
# RTD_CAUSAL_FORCING_USE_EMA=1

# Krea Realtime Video 14B adapter. This is Self-Forcing on Wan2.1 14B and
# requires a newer Diffusers ModularPipeline environment. Keep the large model
# files under your local model root and point RTD_KREA_REALTIME_REPO there.
# RTD_KREA_REALTIME_REPO=D:\models\krea-realtime-video
# RTD_KREA_REALTIME_PYTHON=D:\models\krea-realtime-video\.venv\Scripts\python.exe
# RTD_KREA_REALTIME_ALLOW_DOWNLOAD=0
# RTD_KREA_REALTIME_HF_HOME=D:\models\krea-realtime-video\.hf-cache
# RTD_KREA_REALTIME_MAX_FRAMES=27
# RTD_KREA_REALTIME_BLOCKS=27
# RTD_KREA_REALTIME_DTYPE=bfloat16
# RTD_KREA_REALTIME_STEPS=6
# RTD_KREA_REALTIME_STRENGTH=0.3
# RTD_KREA_REALTIME_TIMEOUT=1800

# FastVideo uses RTDiffusion's native WAN/FastVideo component path by default.
# It can load a Diffusers model id/directory or reuse the WAN 2.2 high/low
# component settings above. The UI can also pass a selected WAN/FastVideo model.
# RTD_FASTVIDEO_MODEL=D:\models\Wan2.2-I2V-A14B-Diffusers
# RTD_NATIVE_FASTVIDEO_MODEL=D:\models\Wan2.2-I2V-A14B-Diffusers
# Optional override for experimental external runners that write PNG frames or
# an MP4 into {output_dir}. Leave unset for the native WAN path.
# RTD_FASTVIDEO_COMMAND=python D:\models\FastVideo\run_rtdiffusion.py --input "{input}" --model "{model_path}" --output "{output_dir}" --prompt "{prompt}" --frames {frames}

# Dasiwa/WAN GGUF and NVFP4 checkpoints are not executable by Diffusers directly.
# Configure a Wan-Video/Dasiwa runtime command to show/select these assets in the UI.
# The command may write PNG frames into {output_dir} or an MP4 there.
# RTD_WAN_GGUF_HIGH_MODEL=D:\models\DasiwaWAN22I2V14BBoundbiteV10_q8High.gguf
# RTD_WAN_GGUF_LOW_MODEL=D:\models\DasiwaWAN22I2V14BBoundbiteV10_q8Low.gguf
# RTD_WAN_GGUF_COMMAND=python D:\models\WanVideo\run_rtdiffusion.py --input "{input}" --output "{output_dir}" --prompt "{prompt}" --negative "{negative_prompt}" --high "{wan_high}" --low "{wan_low}" --frames {frames} --width {width} --height {height} --fps {fps}

# Legacy escape hatch: set RTD_MOTION_BACKEND=command only if you want an
# external script to write PNG frames or an MP4 to {output_dir}.
# RTD_MOTION_BACKEND=command
# RTD_MOTION_COMMAND=python C:\path\to\loop.py --input "{input}" --arrival "{arrival}" --output "{output_dir}"
# RTD_MOTION_TIMEOUT=900
