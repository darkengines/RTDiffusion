# Copy to .env.docker for the CUDA Docker backend. Paths are Linux paths inside
# compose.backend.cuda.yml mounts, not Windows paths.

RTD_DEVICE=cuda
RTD_LOG_LEVEL=INFO
RTD_BACKEND_PORT=8000

# Main realtime image model. Prefer a Diffusers folder such as /models/diffusers/sdxl-turbo
# for StreamDiffusion; single-file inpaint checkpoints work for SDXL but are slower and less
# compatible with direct StreamDiffusion.
RTD_MODEL_PATH=/models/diffusers/sdxl-turbo

RTD_MODEL_DIRS=/models/checkpoints:/models/diffusers:/models/diffusion_models:/models/inpaint:/private-checkpoints
RTD_LORA_DIRS=/models/loras:/private-loras
RTD_VIDEO_MODEL_DIRS=/models/diffusion_models:/models/diffusers:/models/checkpoints

# StreamDiffusion-style realtime path.
RTD_REALTIME_ACCEL=1
RTD_STREAM_NATIVE=1
RTD_STREAM_DIRECT=0
RTD_STREAM_TINY_VAE=1
RTD_STREAM_WARMUP=0
RTD_STREAM_COMPILE=1
RTD_STREAM_LCM_LORA=1
# RTD_STREAM_TRT=0
# RTD_STREAM_TRT_FP16=1
# RTD_STREAM_TRT_CACHE=outputs/trt-engines
RTD_SSF_IMAGE_THRESHOLD=9.0
RTD_SSF_MASK_THRESHOLD=6.0
RTD_SSF_SKIP_PROBABILITY=0.96
RTD_SSF_MAX_SKIPS=12

# Native WAN/FastVideo component paths in the container.
RTD_MOTION_BACKEND=native
RTD_NATIVE_WAN_HIGH_MODEL=/models/diffusion_models/wan22RemixT2VI2V_i2vHighV21.safetensors
RTD_NATIVE_WAN_LOW_MODEL=/models/diffusion_models/wan22RemixT2VI2V_i2vLowV21.safetensors
RTD_NATIVE_WAN_TEXT_ENCODER=/models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors
RTD_NATIVE_WAN_VAE=/models/vae/wan_2.1_vae.safetensors
RTD_NATIVE_VIDEO_MAX_SIDE=768
RTD_NATIVE_VIDEO_MAX_FRAMES=33
RTD_NATIVE_VIDEO_STEPS=8
RTD_NATIVE_VIDEO_CFG=4.5
RTD_NATIVE_VIDEO_CPU_OFFLOAD=1
RTD_NATIVE_WAN_CPU_OFFLOAD=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
RTD_NATIVE_VIDEO_CONFIG_CACHE=/app/outputs/hf-configs
RTD_NATIVE_VIDEO_HF_CACHE=/root/.cache/huggingface

# Krea in Docker can use Linux Triton/Inductor.
RTD_KREA_REALTIME_REPO=/models/krea-realtime-video
RTD_KREA_REALTIME_PYTHON=python
RTD_KREA_REALTIME_ALLOW_DOWNLOAD=1
RTD_KREA_REALTIME_HF_HOME=/root/.cache/huggingface
RTD_KREA_REALTIME_MAX_FRAMES=3
RTD_KREA_REALTIME_INPUT_SIZE=832x480
RTD_KREA_REALTIME_FRAME_SAMPLE_LEN=3
RTD_KREA_REALTIME_STEPS=1
RTD_KREA_REALTIME_STRENGTH=0.3
RTD_KREA_REALTIME_TIMEOUT=900
RTD_KREA_DISABLE_TORCH_COMPILE=0
TORCHDYNAMO_DISABLE=0